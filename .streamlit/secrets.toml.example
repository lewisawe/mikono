# Copy to .streamlit/secrets.toml for local or Streamlit Community Cloud runs.
# Use the READ-ONLY demo user (MIKONO_READONLY), never ACCOUNTADMIN.
# On Streamlit Cloud, paste this block into the app's Secrets settings.

[snowflake]
account = "XUBWKQN-VGC59325"
user = "MIKONO_DEMO"
password = "REPLACE_WITH_DEMO_USER_PASSWORD"
role = "MIKONO_READONLY"
warehouse = "MIKONO_PUBLIC_WH"
database = "MIKONO"
schema = "CORE"
